---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ArrowLeft, FileQuestion } from 'lucide-react';
---

<Layout title="404 - Page Not Found | CSV Cleaner">
  <Navbar />

  <main class="flex-1 max-w-xl mx-auto px-4 py-24 text-center flex flex-col items-center justify-center">
    <div class="h-16 w-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-6">
      <FileQuestion className="w-8 h-8" />
    </div>

    <h1 class="text-4xl font-extrabold text-white tracking-tight mb-2 font-mono">404</h1>
    <h2 class="text-lg font-semibold text-slate-200 mb-3">Page Not Found</h2>
    <p class="text-xs text-slate-400 max-w-sm mb-8 leading-relaxed">
      The dataset or cleaning utility route you are trying to access does not exist or has been relocated.
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-xs transition-all shadow-md cursor-pointer"
    >
      <ArrowLeft className="w-4 h-4" />
      Back to Cleaner Studio
    </a>
  </main>

  <Footer />
</Layout>