---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Support - CSV Cleaner">
  <Navbar />
  <main class="flex-1 max-w-xl mx-auto px-4 sm:px-6 py-12 text-slate-300">
    <h1 class="text-2xl font-bold text-white mb-2">Contact Support</h1>
    <p class="text-xs text-slate-400 mb-6">Have a question or found a bug? Send us a message.</p>

    <form class="space-y-4 bg-[#161b22] border border-slate-800 rounded-xl p-6 shadow-xl">
      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1.5">Name</label>
        <input type="text" placeholder="Your name" class="w-full rounded-lg border border-slate-700 bg-[#0d1117] p-2.5 text-xs text-white placeholder-slate-500 focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1.5">Email</label>
        <input type="email" placeholder="you@example.com" class="w-full rounded-lg border border-slate-700 bg-[#0d1117] p-2.5 text-xs text-white placeholder-slate-500 focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1.5">Message</label>
        <textarea rows="4" placeholder="How can we help?" class="w-full rounded-lg border border-slate-700 bg-[#0d1117] p-2.5 text-xs text-white placeholder-slate-500 focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none resize-none font-sans"></textarea>
      </div>

      <button type="button" class="w-full py-2.5 px-4 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-xs transition-all shadow-md cursor-pointer">
        Send Message
      </button>
    </form>
  </main>
  <Footer />
</Layout>