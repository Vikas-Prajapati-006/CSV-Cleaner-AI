---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "CSV Cleaner — High Speed Tabular Sanitizer", 
  description = "A fast, privacy-focused data cleaning tool." 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://csvcleaner.ai");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="csv cleaner, clean csv online, remove duplicate rows, csv data cleaning tool, fill missing values in csv, convert date format csv" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Structured Data (JSON-LD) for Search Engine Rich Snippets -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "CSV Cleaner AI",
        "operatingSystem": "All",
        "applicationCategory": "DeveloperApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Zero-token streaming CSV sanitizer and AST-sandboxed data cleaner."
      }
    </script>
  </head>
  <body class="min-h-screen bg-[#0d1117] text-slate-100 antialiased flex flex-col justify-between selection:bg-emerald-500/30 selection:text-emerald-200">
    <slot />
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  body {
    font-family: 'Inter', system-ui, sans-serif;
  }
  .font-mono {
    font-family: 'Geist Mono', monospace;
  }
</style>