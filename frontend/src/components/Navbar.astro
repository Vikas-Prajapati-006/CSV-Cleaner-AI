---
import { ShieldCheck, Table } from 'lucide-react';
---

<header class="border-b border-slate-800 bg-[#161b22] sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="h-7 w-7 rounded bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
        <Table className="w-4 h-4" />
      </div>
      <a href="/" class="text-sm font-semibold text-white tracking-tight flex items-center gap-2">
        CSV Cleaner
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-emerald-400 border border-slate-700">Studio</span>
      </a>
    </div>

    <div class="flex items-center gap-6 text-xs text-slate-300">
      <div class="hidden sm:flex items-center gap-1.5 text-slate-400">
        <ShieldCheck className="w-3.5 h-3.5 text-emerald-400" />
        <span>AST-Sandbox Protected</span>
      </div>
      <div class="h-3.5 w-px bg-slate-800 hidden sm:block"></div>
      <nav class="flex items-center gap-5 font-medium">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms</a>
        <a href="/contact" class="hover:text-white transition-colors">Contact</a>
      </nav>
    </div>
  </div>
</header>